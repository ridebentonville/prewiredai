---
/**
 * Interactive sample preview for the Jobber Morning Ops Triage Copilot page.
 * Fictional sample only (numbers match packs/jobber-morning-ops-copilot/sample_morning_digest.md).
 * Lightweight vanilla JS/CSS, no extra dependencies. No video: none exists for this pack.
 */
import { siteConfig } from "../config";

const accent = siteConfig.accentColor;
---

<section class="border-b border-stone-200" aria-labelledby="jb-preview-heading">
  <div class="mx-auto max-w-6xl px-6 py-12 sm:px-10">
    <h2 id="jb-preview-heading" class="text-xl font-medium tracking-tight text-stone-950">
      Sample Preview: What You See at 7:00 AM
    </h2>
    <div class="mt-3 h-1 w-10 rounded-full" style={`background-color: ${accent}`}></div>
    <p class="mt-4 max-w-3xl text-sm leading-relaxed text-stone-600">
      Bluestem Home Services is a fictional lawn, HVAC, and plumbing shop. Explore its sample morning digest, ranked quotes and invoices, and the read-only workflow.
    </p>

    <div class="jb-preview mt-8" data-jb-preview>
      <div class="jb-preview__tabs" role="tablist" aria-label="Sample morning ops preview">
        <button type="button" role="tab" id="jb-tab-digest" aria-controls="jb-panel-digest" aria-selected="true" data-tab="digest" class="jb-preview__tab is-active">
          7:00 AM Morning Ops Digest (Slack / Email)
        </button>
        <button type="button" role="tab" id="jb-tab-leaks" aria-controls="jb-panel-leaks" aria-selected="false" data-tab="leaks" class="jb-preview__tab" tabindex="-1">
          Quote &amp; Invoice Leak Queue
        </button>
        <button type="button" role="tab" id="jb-tab-arch" aria-controls="jb-panel-arch" aria-selected="false" data-tab="arch" class="jb-preview__tab" tabindex="-1">
          Zero Write-Back Architecture
        </button>
      </div>

      <div class="jb-preview__stage">
        <div id="jb-panel-digest" role="tabpanel" aria-labelledby="jb-tab-digest" data-panel="digest" class="jb-preview__panel is-active">
          <article class="jb-card" aria-label="Sample Slack and email morning ops digest">
            <header class="jb-card__top">
              <span class="jb-card__app">Slack / Email</span>
              <span class="jb-card__time">Tue Mar 10 · 7:00 AM</span>
            </header>
            <p class="jb-card__channel">#ops-owner-only · Bluestem Home Services (fictional sample)</p>
            <h3 class="jb-card__title">[TEST] Morning Ops Triage Digest</h3>
            <p class="jb-card__lede">
              Three queues in one message. Read-only. Owner-only. Built from fictional sample data.
            </p>
            <dl class="jb-stats">
              <div>
                <dt>Jobs needing attention</dt>
                <dd>7</dd>
              </div>
              <div>
                <dt>Ready to invoice</dt>
                <dd>3</dd>
              </div>
              <div>
                <dt>Past-due invoices</dt>
                <dd>3</dd>
              </div>
              <div>
                <dt>Quotes worth a call</dt>
                <dd>4</dd>
              </div>
            </dl>
            <div class="jb-msg">
              <p class="jb-msg__k">1. Unscheduled, Late &amp; Action Required</p>
              <ul>
                <li>
                  <strong>Job 1002</strong> · Furnace no heat repair · Sample Household 5002
                  <span class="jb-pill jb-pill--warn">Late 4 days</span>
                </li>
                <li>
                  <strong>Job 1003</strong> · Water heater swap · Sample Household 5003
                  <span class="jb-pill jb-pill--warn">Action Required</span>
                </li>
                <li>
                  <strong>Job 1004</strong> · Spring cleanup and mulch · Sample Household 5004
                  <span class="jb-pill">Unscheduled 8 days</span>
                </li>
              </ul>
              <p class="jb-msg__k">2. Requires Invoicing &amp; past due</p>
              <ul>
                <li>Job 1006 · Drain clearing · finished 5 days ago, no invoice yet</li>
                <li>Invoice 2001 · Sample Household 5021 · 24 days past due</li>
              </ul>
              <p class="jb-msg__k">3. Quotes for a human call</p>
              <ul>
                <li>Quote 3001 · Full HVAC system replacement · sent 28 days ago, still awaiting a response</li>
              </ul>
              <p class="jb-msg__k">Heads-up</p>
              <ul>
                <li>1 Requires Invoicing job has no total, so the dollar figure covers only the others.</li>
              </ul>
            </div>
            <p class="jb-card__foot">[TEST] Draft pack. Read-only. Zero write-back. Owner-only delivery. Shortened for this preview.</p>
          </article>
        </div>

        <div id="jb-panel-leaks" role="tabpanel" aria-labelledby="jb-tab-leaks" data-panel="leaks" class="jb-preview__panel" hidden>
          <article class="jb-card jb-card--alert" aria-label="Sample quote and invoice leak queue">
            <header class="jb-card__top">
              <span class="jb-card__app">Ranked follow-up list</span>
              <span class="jb-card__time">For a person to call</span>
            </header>
            <p class="jb-card__channel">Bluestem Home Services (fictional sample) · quotes of $1,000+ awaiting a response 14+ days</p>
            <h3 class="jb-card__title">[TEST] Quote &amp; Invoice Leak Queue</h3>
            <p class="jb-card__lede">
              These fictional quotes are still awaiting a response beyond the sample cutoff. The owner can choose whom to call.
            </p>
            <div class="jb-msg">
              <p class="jb-msg__k">Stalled quotes, ranked by value</p>
              <ol class="jb-rank">
                <li><span class="jb-rank__v">$14,800</span> Quote 3001 · Full HVAC system replacement · sent 28 days ago</li>
                <li><span class="jb-rank__v">$6,200</span> Quote 3002 · Backyard drainage and sod · sent 14 days ago</li>
                <li><span class="jb-rank__v">$3,300</span> Quote 3009 · Irrigation system install · sent 49 days ago</li>
                <li><span class="jb-rank__v">$1,000</span> Quote 3004 · Patio and walkway lighting · sent 35 days ago</li>
              </ol>
              <p class="jb-msg__k">Past-due invoices, largest balance first</p>
              <ol class="jb-rank">
                <li><span class="jb-rank__v">$3,200</span> Invoice 2001 · 24 days past due</li>
                <li><span class="jb-rank__v">$625</span> Invoice 2003 · 1 day past due (partial balance)</li>
                <li><span class="jb-rank__v">$480</span> Invoice 2002 · 8 days past due</li>
              </ol>
              <p class="jb-msg__k">Not listed, on purpose</p>
              <ul>
                <li>Approved, drafted, and changes-requested quotes. A quote 13 days old. A quote under the value you set.</li>
                <li>An invoice due today. Paid, draft, and bad-debt invoices.</li>
              </ul>
            </div>
            <p class="jb-card__foot">[TEST] Fictional sample. Day counts and dollar floors are settings you choose, not industry standards.</p>
          </article>
        </div>

        <div id="jb-panel-arch" role="tabpanel" aria-labelledby="jb-tab-arch" data-panel="arch" class="jb-preview__panel" hidden>
          <div class="jb-arch" aria-label="Zero write-back architecture">
            <p class="jb-arch__intro">
              You stay in control. The copilot only reads your Jobber reports and sends you a digest. It never
              schedules, reschedules, or deletes a job, and it never messages a customer. Both workflows import
              inactive, in <strong>[TEST]</strong> mode.
            </p>
            <ol class="jb-flow">
              <li class="jb-flow__step">
                <span class="jb-flow__n">1</span>
                <div>
                  <p class="jb-flow__t">Jobber</p>
                  <p class="jb-flow__d">Jobs, invoices, and quotes stay where they are. This pack does not write back.</p>
                </div>
              </li>
              <li class="jb-flow__branch" aria-hidden="true">
                <span></span>
              </li>
              <li class="jb-flow__split">
                <div class="jb-flow__card">
                  <p class="jb-flow__t">GraphQL (OAuth Draft app)</p>
                  <p class="jb-flow__d">Read-only queries, no mutations. The complete queries still need a live Jobber test.</p>
                </div>
                <p class="jb-flow__or">or</p>
                <div class="jb-flow__card">
                  <p class="jb-flow__t">CSV reports (recommended start)</p>
                  <p class="jb-flow__d">Your Jobs, Invoices, and Quotes exports, by email, upload, or folder. No OAuth, no App Review.</p>
                </div>
              </li>
              <li class="jb-flow__branch" aria-hidden="true">
                <span></span>
              </li>
              <li class="jb-flow__step">
                <span class="jb-flow__n">2</span>
                <div>
                  <p class="jb-flow__t">n8n (your instance)</p>
                  <p class="jb-flow__d">Two read-only workflows: the 7:00 AM Jobber digest and the CSV-Fallback companion. Both ship inactive, with [TEST] on.</p>
                </div>
              </li>
              <li class="jb-flow__branch" aria-hidden="true">
                <span></span>
              </li>
              <li class="jb-flow__step">
                <span class="jb-flow__n">3</span>
                <div>
                  <p class="jb-flow__t">Slack / Email to the owner</p>
                  <p class="jb-flow__d">One morning digest. Never sent to a customer. Never written back to Jobber.</p>
                </div>
              </li>
            </ol>
            <p class="jb-arch__stop">
              <strong>Zero write-back.</strong> Configure a quote cutoff after your last Jobber follow-up. The digest ranks quotes still awaiting a response.
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .jb-preview__tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .jb-preview__tab {
    border: 1px solid #e7e5e4;
    background: #fff;
    color: #44403c;
    border-radius: 9999px;
    padding: 0.5rem 0.9rem;
    font-size: 0.8125rem;
    line-height: 1.3;
    cursor: pointer;
  }
  .jb-preview__tab:hover {
    border-color: #a8a29e;
  }
  .jb-preview__tab:focus-visible {
    outline: 2px solid var(--accent, #1f4d3a);
    outline-offset: 2px;
  }
  .jb-preview__tab.is-active {
    background: var(--accent, #1f4d3a);
    border-color: var(--accent, #1f4d3a);
    color: #fff;
  }
  .jb-preview__stage {
    margin-top: 1.25rem;
  }
  .jb-preview__panel[hidden] {
    display: none;
  }
  .jb-card,
  .jb-arch {
    border: 1px solid #e7e5e4;
    background: #fff;
    border-radius: 1rem;
    padding: 1.25rem 1.35rem;
  }
  .jb-card__top {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    font-size: 0.7rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #78716c;
  }
  .jb-card__channel {
    margin-top: 0.35rem;
    font-size: 0.8125rem;
    color: #57534e;
  }
  .jb-card__title {
    margin-top: 0.85rem;
    font-size: 1.05rem;
    font-weight: 500;
    color: #0c0a09;
  }
  .jb-card__lede {
    margin-top: 0.45rem;
    font-size: 0.875rem;
    line-height: 1.55;
    color: #44403c;
  }
  .jb-stats {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.65rem;
    margin: 1.1rem 0;
  }
  @media (min-width: 640px) {
    .jb-stats {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
  .jb-stats div {
    border: 1px solid #e7e5e4;
    border-radius: 0.75rem;
    background: #fafaf9;
    padding: 0.7rem 0.8rem;
  }
  .jb-stats dt {
    font-size: 0.68rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #78716c;
  }
  .jb-stats dd {
    margin-top: 0.2rem;
    font-size: 1.4rem;
    font-weight: 500;
    color: #0c0a09;
  }
  .jb-msg__k {
    margin-top: 0.9rem;
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent, #1f4d3a);
  }
  .jb-msg ul,
  .jb-msg ol {
    margin: 0.35rem 0 0;
    padding: 0;
    list-style: none;
  }
  .jb-msg li {
    position: relative;
    margin-top: 0.35rem;
    padding: 0.45rem 0.6rem;
    border-radius: 0.5rem;
    background: #f5f5f4;
    font-size: 0.875rem;
    line-height: 1.45;
    color: #292524;
  }
  .jb-rank__v {
    display: inline-block;
    min-width: 4.5rem;
    margin-right: 0.35rem;
    font-weight: 600;
    color: #0c0a09;
    font-variant-numeric: tabular-nums;
  }
  .jb-card__foot {
    margin-top: 1rem;
    font-size: 0.75rem;
    color: #78716c;
  }
  .jb-pill {
    display: inline-block;
    margin-left: 0.35rem;
    border-radius: 9999px;
    background: var(--accent, #1f4d3a);
    color: #fff;
    font-size: 0.65rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 0.1rem 0.45rem;
    vertical-align: middle;
  }
  .jb-pill--warn {
    background: #9a3412;
  }
  .jb-arch__intro,
  .jb-arch__stop,
  .jb-flow__d {
    font-size: 0.875rem;
    line-height: 1.55;
    color: #44403c;
  }
  .jb-arch__stop {
    margin-top: 1.1rem;
    border-radius: 0.75rem;
    border: 1px solid #d6d3d1;
    background: #fafaf9;
    padding: 0.8rem 0.9rem;
  }
  .jb-flow {
    margin: 1.1rem 0 0;
    padding: 0;
    list-style: none;
  }
  .jb-flow__step {
    display: flex;
    gap: 0.85rem;
    align-items: flex-start;
    border: 1px solid #e7e5e4;
    border-radius: 0.85rem;
    background: #fafaf9;
    padding: 0.85rem 0.95rem;
  }
  .jb-flow__n {
    flex: 0 0 1.6rem;
    height: 1.6rem;
    border-radius: 9999px;
    background: var(--accent, #1f4d3a);
    color: #fff;
    font-size: 0.75rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }
  .jb-flow__t {
    font-size: 0.9rem;
    font-weight: 500;
    color: #0c0a09;
  }
  .jb-flow__branch {
    display: flex;
    justify-content: center;
    height: 1.1rem;
  }
  .jb-flow__branch span {
    width: 1px;
    background: #a8a29e;
  }
  .jb-flow__split {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.6rem;
  }
  @media (min-width: 768px) {
    .jb-flow__split {
      grid-template-columns: 1fr auto 1fr;
      align-items: stretch;
    }
  }
  .jb-flow__card {
    border: 1px solid #e7e5e4;
    border-radius: 0.85rem;
    background: #fff;
    padding: 0.85rem 0.95rem;
  }
  .jb-flow__or {
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #78716c;
  }
</style>

<script is:inline>
  (function () {
    var root = document.querySelector("[data-jb-preview]");
    if (!root) return;
    var tabs = Array.prototype.slice.call(root.querySelectorAll('[role="tab"]'));
    var panels = Array.prototype.slice.call(root.querySelectorAll('[role="tabpanel"]'));
    function activate(name, focusTab) {
      tabs.forEach(function (tab) {
        var on = tab.getAttribute("data-tab") === name;
        tab.classList.toggle("is-active", on);
        tab.setAttribute("aria-selected", on ? "true" : "false");
        tab.tabIndex = on ? 0 : -1;
        if (on && focusTab) tab.focus();
      });
      panels.forEach(function (panel) {
        var on = panel.getAttribute("data-panel") === name;
        panel.classList.toggle("is-active", on);
        if (on) panel.removeAttribute("hidden");
        else panel.setAttribute("hidden", "");
      });
    }
    tabs.forEach(function (tab, i) {
      tab.addEventListener("click", function () {
        activate(tab.getAttribute("data-tab"), false);
      });
      tab.addEventListener("keydown", function (event) {
        var next = i;
        if (event.key === "ArrowRight" || event.key === "ArrowDown") next = (i + 1) % tabs.length;
        else if (event.key === "ArrowLeft" || event.key === "ArrowUp") next = (i - 1 + tabs.length) % tabs.length;
        else if (event.key === "Home") next = 0;
        else if (event.key === "End") next = tabs.length - 1;
        else return;
        event.preventDefault();
        activate(tabs[next].getAttribute("data-tab"), true);
      });
    });
  })();
</script>
