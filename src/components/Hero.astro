---
import { siteConfig } from "../config";

const links = [
  siteConfig.social.email
    ? {
        href: `mailto:${siteConfig.social.email}`,
        label: siteConfig.social.email,
        external: false,
      }
    : null,
  siteConfig.social.linkedin
    ? {
        href: siteConfig.social.linkedin,
        label: "LinkedIn",
        external: true,
      }
    : null,
  siteConfig.social.website
    ? {
        href: siteConfig.social.website,
        label: siteConfig.social.websiteLabel ?? siteConfig.social.website,
        external: true,
      }
    : null,
].filter((link) => link !== null);
---

<section id="top" class="border-b border-stone-200">
  <div class="mx-auto max-w-6xl px-6 py-14 sm:px-10 sm:py-20 lg:py-24">
    <p class="text-xs uppercase tracking-[0.18em] text-stone-500">
      {siteConfig.location}
    </p>
    <h1
      class="mt-5 max-w-4xl text-4xl font-medium leading-[1.05] tracking-tight text-stone-950 sm:text-6xl lg:text-7xl"
    >
      {siteConfig.name}
    </h1>
    <p class="mt-6 max-w-3xl text-lg leading-snug text-stone-800 sm:text-2xl">
      {siteConfig.heroLead}
    </p>
    <p class="mt-4 max-w-2xl text-sm leading-relaxed text-stone-600 sm:text-base">
      {siteConfig.heroBody}
    </p>

    <div class="mt-8 border-t border-stone-200 pt-6">
      <p class="text-xs uppercase tracking-[0.18em] text-stone-500">
        Applying for
      </p>
      <p class="mt-2 text-sm text-stone-800 sm:text-base">
        {siteConfig.roles.join("  ·  ")}
      </p>
      <ul class="mt-5 flex flex-col gap-3 sm:flex-row sm:flex-wrap sm:gap-x-8 sm:gap-y-3">
        {
          links.map((link) => (
            <li>
              <a
                href={link.href}
                class="text-sm text-stone-950 underline decoration-stone-300 underline-offset-4 hover:decoration-[var(--accent)]"
                {...(link.external
                  ? { target: "_blank", rel: "noopener noreferrer" }
                  : {})}
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>
