---
import { siteConfig } from "../config";

const email = siteConfig.social.email;
const schedulingUrl = siteConfig.schedulingUrl?.trim();

const links = [
  siteConfig.social.linkedin
    ? { href: siteConfig.social.linkedin, label: "LinkedIn" }
    : null,
  siteConfig.social.github
    ? { href: siteConfig.social.github, label: "GitHub" }
    : null,
  siteConfig.social.website
    ? {
        href: siteConfig.social.website,
        label: siteConfig.social.websiteLabel ?? siteConfig.social.website,
      }
    : null,
].filter((link) => link !== null);

const hasCaseStudies =
  siteConfig.caseStudies && siteConfig.caseStudies.length > 0;
---

<section id="top" class="border-b border-stone-200">
  <div class="mx-auto flex max-w-6xl flex-col gap-10 px-6 py-14 sm:px-10 sm:py-20 lg:flex-row lg:items-center lg:justify-between lg:py-24">
    <div class="hero-rise max-w-3xl">
      <p class="text-xs uppercase tracking-[0.18em] text-stone-500">
        {siteConfig.name} · {siteConfig.location}
      </p>
      <h1
        class="mt-5 max-w-4xl text-4xl font-medium leading-[1.08] tracking-tight text-stone-950 sm:text-5xl lg:text-6xl"
      >
        {siteConfig.heroHeadline}
      </h1>
      <p class="mt-6 max-w-2xl text-base leading-relaxed text-stone-700 sm:text-lg">
        {siteConfig.heroLead}
      </p>

      <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:flex-wrap sm:items-center">
        {
          email && (
            <a
              href={`mailto:${email}`}
              class="inline-flex items-center justify-center rounded-md px-5 py-3 text-sm font-medium text-white transition-opacity hover:opacity-90"
              style={`background-color: ${siteConfig.accentColor}`}
            >
              Email me
            </a>
          )
        }
        {
          schedulingUrl && (
            <a
              href={schedulingUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center justify-center rounded-md border border-stone-300 bg-white px-5 py-3 text-sm font-medium text-stone-950 hover:border-stone-500"
            >
              Book a call
            </a>
          )
        }
        {
          hasCaseStudies && (
            <a
              href="#case-studies"
              class="inline-flex items-center justify-center rounded-md border border-stone-300 bg-white px-5 py-3 text-sm font-medium text-stone-950 hover:border-stone-500"
            >
              See the work
            </a>
          )
        }
      </div>

      <p class="mt-5 text-sm text-stone-600">{siteConfig.openTo}</p>

      <ul class="mt-6 flex flex-wrap gap-x-6 gap-y-2 border-t border-stone-200 pt-5">
        {
          email && (
            <li>
              <a
                href={`mailto:${email}`}
                class="text-sm text-stone-950 underline decoration-stone-300 underline-offset-4 hover:decoration-[var(--accent)]"
              >
                {email}
              </a>
            </li>
          )
        }
        {
          links.map((link) => (
            <li>
              <a
                href={link.href}
                target="_blank"
                rel="noopener noreferrer"
                class="text-sm text-stone-950 underline decoration-stone-300 underline-offset-4 hover:decoration-[var(--accent)]"
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
    {
      siteConfig.headshot && (
        <img
          src={siteConfig.headshot.src}
          srcset={siteConfig.headshot.srcSmall ? `${siteConfig.headshot.srcSmall} 256w, ${siteConfig.headshot.src} ${siteConfig.headshot.width}w` : undefined}
          sizes="(min-width: 1024px) 224px, (min-width: 640px) 176px, 144px"
          alt={siteConfig.headshot.alt}
          width={siteConfig.headshot.width}
          height={siteConfig.headshot.height}
          fetchpriority="high"
          class="order-first h-36 w-36 shrink-0 rounded-full object-cover ring-1 ring-stone-300 sm:h-44 sm:w-44 lg:order-last lg:h-56 lg:w-56"
        />
      )
    }
  </div>
</section>
