---
/** Solo / Team / Done-for-you tiers. With a pack, shows that pack's price per tier. */
import { siteConfig } from "../config";
import { tiers, tierPrice, PRICE_PENDING, type TemplatePack } from "../templates";

interface Props {
  pack?: TemplatePack;
}

const { pack } = Astro.props;
---

<ul class="grid grid-cols-1 gap-4 md:grid-cols-3">
  {
    tiers.map((tier) => {
      const price = pack ? tierPrice(pack, tier.id) : tier.id === "solo" ? `Free (Manager Digest) or ${PRICE_PENDING.toLowerCase()}` : PRICE_PENDING;
      const isFree = price === "Free";
      return (
        <li class="flex flex-col rounded-2xl border border-stone-200 bg-white p-5">
          <p class="text-sm font-medium text-stone-950">{tier.label}</p>
          <p class="mt-2 text-sm leading-relaxed text-stone-600">{tier.description}</p>
          <p
            class:list={[
              "mt-auto pt-4 text-sm font-medium",
              isFree ? "" : "text-stone-700",
            ]}
            style={isFree ? `color: ${siteConfig.accentColor}` : undefined}
          >
            {price}
          </p>
        </li>
      );
    })
  }
</ul>
