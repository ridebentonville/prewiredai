---
/**
 * Interactive sample preview for the Housecall Pro CSV-First Morning Ops Copilot page.
 * Fictional sample only (numbers match packs/housecall-pro-morning-ops-copilot/sample_morning_digest.md).
 * Lightweight vanilla JS/CSS, no extra dependencies. No video: none exists for this pack. No pack price.
 */
import { siteConfig } from "../config";

const accent = siteConfig.accentColor;
---

<section class="border-b border-stone-200" aria-labelledby="hcp-preview-heading">
  <div class="mx-auto max-w-6xl px-6 py-12 sm:px-10">
    <h2 id="hcp-preview-heading" class="text-xl font-medium tracking-tight text-stone-950">
      Sample Preview: What You See at 7:00 AM
    </h2>
    <div class="mt-3 h-1 w-10 rounded-full" style={`background-color: ${accent}`}></div>
    <p class="mt-4 max-w-3xl text-sm leading-relaxed text-stone-600">
      Cedar Creek Plumbing &amp; Air is a fictional plumbing and HVAC shop. Everything below is made-up sample data. Explore its sample morning digest, the three queues, and the read-only CSV workflow.
    </p>

    <div class="hcp-preview mt-8" data-hcp-preview>
      <div class="hcp-preview__tabs" role="tablist" aria-label="Sample Housecall Pro morning ops preview">
        <button type="button" role="tab" id="hcp-tab-digest" aria-controls="hcp-panel-digest" aria-selected="true" data-tab="digest" class="hcp-preview__tab is-active">
          7:00 AM Morning Ops Digest (Slack / Email)
        </button>
        <button type="button" role="tab" id="hcp-tab-queues" aria-controls="hcp-panel-queues" aria-selected="false" data-tab="queues" class="hcp-preview__tab" tabindex="-1">
          Invoice &amp; Estimate Queues
        </button>
        <button type="button" role="tab" id="hcp-tab-arch" aria-controls="hcp-panel-arch" aria-selected="false" data-tab="arch" class="hcp-preview__tab" tabindex="-1">
          CSV-First, Zero Write-Back Architecture
        </button>
      </div>

      <div class="hcp-preview__stage">
        <div id="hcp-panel-digest" role="tabpanel" aria-labelledby="hcp-tab-digest" data-panel="digest" class="hcp-preview__panel is-active">
          <article class="hcp-card" aria-label="Sample Slack and email morning ops digest">
            <header class="hcp-card__top">
              <span class="hcp-card__app">Slack / Email</span>
              <span class="hcp-card__time">Tue Jun 9 · 7:00 AM</span>
            </header>
            <p class="hcp-card__channel">#ops-owner-only · Cedar Creek Plumbing &amp; Air (fictional sample)</p>
            <h3 class="hcp-card__title">[TEST] Morning Ops Triage Digest</h3>
            <p class="hcp-card__lede">
              Three queues in one message, built from your Housecall Pro CSV exports. Read-only. Owner-only. Built from fictional sample data.
            </p>
            <dl class="hcp-stats">
              <div>
                <dt>Jobs needing attention</dt>
                <dd>9</dd>
              </div>
              <div>
                <dt>Ready to invoice</dt>
                <dd>3</dd>
              </div>
              <div>
                <dt>Past-due invoices</dt>
                <dd>4</dd>
              </div>
              <div>
                <dt>Estimates worth a call</dt>
                <dd>4</dd>
              </div>
            </dl>
            <div class="hcp-msg">
              <p class="hcp-msg__k">1. Unscheduled, late &amp; needs office action</p>
              <ul>
                <li>
                  <strong>Job 4104</strong> · Slab leak repair · Sample Customer 6104
                  <span class="hcp-pill hcp-pill--warn">Late 4 days</span>
                </li>
                <li>
                  <strong>Job 4105</strong> · Sewer camera inspection · Sample Customer 6105
                  <span class="hcp-pill hcp-pill--warn">Needs office action</span>
                </li>
                <li>
                  <strong>Job 4101</strong> · Tankless water heater install · Sample Customer 6101
                  <span class="hcp-pill">Unscheduled 8 days</span>
                </li>
              </ul>
              <p class="hcp-msg__k">2. Ready to invoice &amp; past due</p>
              <ul>
                <li>Job 4109 · Drain clearing · finished 5 days ago, no invoice yet</li>
                <li>Job 4110 · Heat pump repair · invoice created but not sent</li>
                <li>Invoice 7001 · Sample Customer 6201 · 24 days past due</li>
              </ul>
              <p class="hcp-msg__k">3. Estimates for a human call</p>
              <ul>
                <li>Estimate 8101 · Full HVAC system replacement · sent 20 days ago, still awaiting a response</li>
              </ul>
              <p class="hcp-msg__k">Heads-up</p>
              <ul>
                <li>1 ready-to-invoice job has no total, so the dollar figure covers only the others.</li>
              </ul>
            </div>
            <p class="hcp-card__foot">[TEST] Draft pack. Read-only. Zero write-back. Owner-only delivery. Shortened for this preview.</p>
          </article>
        </div>

        <div id="hcp-panel-queues" role="tabpanel" aria-labelledby="hcp-tab-queues" data-panel="queues" class="hcp-preview__panel" hidden>
          <article class="hcp-card hcp-card--alert" aria-label="Sample invoice and estimate queues">
            <header class="hcp-card__top">
              <span class="hcp-card__app">Ranked follow-up lists</span>
              <span class="hcp-card__time">For a person to call</span>
            </header>
            <p class="hcp-card__channel">Cedar Creek Plumbing &amp; Air (fictional sample) · estimates of $1,000+ awaiting a response 14+ days</p>
            <h3 class="hcp-card__title">[TEST] Invoice &amp; Estimate Queues</h3>
            <p class="hcp-card__lede">
              These fictional estimates were sent and are still awaiting a response beyond the sample cutoff. The owner chooses whom to call.
            </p>
            <div class="hcp-msg">
              <p class="hcp-msg__k">Stalled estimates, ranked by value</p>
              <ol class="hcp-rank">
                <li><span class="hcp-rank__v">$14,800</span> Estimate 8101 · Full HVAC system replacement · sent 20 days ago</li>
                <li><span class="hcp-rank__v">$9,500</span> Estimate 8102 · Sewer line replacement · sent 14 days ago</li>
                <li><span class="hcp-rank__v">$3,300</span> Estimate 8112 · Furnace and coil replacement · sent 28 days ago</li>
                <li><span class="hcp-rank__v">$1,000</span> Estimate 8104 · Water softener install · sent 30 days ago</li>
              </ol>
              <p class="hcp-msg__k">Past-due invoices, largest balance first</p>
              <ol class="hcp-rank">
                <li><span class="hcp-rank__v">$3,200</span> Invoice 7001 · 24 days past due</li>
                <li><span class="hcp-rank__v">$625</span> Invoice 7009 · 8 days past due (partial balance)</li>
                <li><span class="hcp-rank__v">$480</span> Invoice 7002 · 7 days past due</li>
                <li><span class="hcp-rank__v">$350</span> Invoice 7005 · 1 day past due</li>
              </ol>
              <p class="hcp-msg__k">Not listed, on purpose</p>
              <ul>
                <li>Draft, approved, declined, and expired estimates. An estimate sent 13 days ago. An estimate under the value you set. An estimate with no send date.</li>
                <li>An invoice due today. Paid, void, and unsent invoices (unsent ones show up under ready to invoice).</li>
              </ul>
            </div>
            <p class="hcp-card__foot">[TEST] Fictional sample. Day counts and dollar floors are settings you choose, not industry standards.</p>
          </article>
        </div>

        <div id="hcp-panel-arch" role="tabpanel" aria-labelledby="hcp-tab-arch" data-panel="arch" class="hcp-preview__panel" hidden>
          <div class="hcp-arch" aria-label="CSV-first, zero write-back architecture">
            <p class="hcp-arch__intro">
              You stay in control. The copilot only reads CSV files you give it and sends you a digest. It never
              schedules, reschedules, or deletes a job, and it never messages a customer. The workflow imports
              inactive, in <strong>[TEST]</strong> mode.
            </p>
            <ol class="hcp-flow">
              <li class="hcp-flow__step">
                <span class="hcp-flow__n">1</span>
                <div>
                  <p class="hcp-flow__t">Housecall Pro</p>
                  <p class="hcp-flow__d">Your jobs, invoices, and estimates stay where they are. This pack does not connect to Housecall Pro and does not write back.</p>
                </div>
              </li>
              <li class="hcp-flow__branch" aria-hidden="true">
                <span></span>
              </li>
              <li class="hcp-flow__split">
                <div class="hcp-flow__card">
                  <p class="hcp-flow__t">CSV exports (the product)</p>
                  <p class="hcp-flow__d">Your Jobs, Invoices, and Estimates exports, by email attachment, upload, or watch folder. No API key, no plan upgrade.</p>
                </div>
                <p class="hcp-flow__or">not</p>
                <div class="hcp-flow__card">
                  <p class="hcp-flow__t">Open API / webhooks (MAX-only)</p>
                  <p class="hcp-flow__d">Officially limited to the MAX plan, so this version does not use them. An optional read-only add-on for MAX shops is a future note, not shipped.</p>
                </div>
              </li>
              <li class="hcp-flow__branch" aria-hidden="true">
                <span></span>
              </li>
              <li class="hcp-flow__step">
                <span class="hcp-flow__n">2</span>
                <div>
                  <p class="hcp-flow__t">n8n (your instance)</p>
                  <p class="hcp-flow__d">One read-only workflow with a manual run, a 7:00 AM schedule, an email-attachment trigger, and an upload webhook. It ships inactive, with [TEST] on.</p>
                </div>
              </li>
              <li class="hcp-flow__branch" aria-hidden="true">
                <span></span>
              </li>
              <li class="hcp-flow__step">
                <span class="hcp-flow__n">3</span>
                <div>
                  <p class="hcp-flow__t">Slack / Email to the owner</p>
                  <p class="hcp-flow__d">One morning digest. Never sent to a customer. Never written back to Housecall Pro.</p>
                </div>
              </li>
            </ol>
            <p class="hcp-arch__stop">
              <strong>Zero write-back.</strong> Set an estimate cutoff after the last follow-up your shop already sends. The digest ranks estimates still awaiting a response. Not yet tested against a live Housecall Pro, Gmail, or Slack account.
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hcp-preview__tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .hcp-preview__tab {
    border: 1px solid #e7e5e4;
    background: #fff;
    color: #44403c;
    border-radius: 9999px;
    padding: 0.5rem 0.9rem;
    font-size: 0.8125rem;
    line-height: 1.3;
    cursor: pointer;
  }
  .hcp-preview__tab:hover {
    border-color: #a8a29e;
  }
  .hcp-preview__tab:focus-visible {
    outline: 2px solid var(--accent, #1f4d3a);
    outline-offset: 2px;
  }
  .hcp-preview__tab.is-active {
    background: var(--accent, #1f4d3a);
    border-color: var(--accent, #1f4d3a);
    color: #fff;
  }
  .hcp-preview__stage {
    margin-top: 1.25rem;
  }
  .hcp-preview__panel[hidden] {
    display: none;
  }
  .hcp-card,
  .hcp-arch {
    border: 1px solid #e7e5e4;
    background: #fff;
    border-radius: 1rem;
    padding: 1.25rem 1.35rem;
  }
  .hcp-card__top {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    font-size: 0.7rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #78716c;
  }
  .hcp-card__channel {
    margin-top: 0.35rem;
    font-size: 0.8125rem;
    color: #57534e;
  }
  .hcp-card__title {
    margin-top: 0.85rem;
    font-size: 1.05rem;
    font-weight: 500;
    color: #0c0a09;
  }
  .hcp-card__lede {
    margin-top: 0.45rem;
    font-size: 0.875rem;
    line-height: 1.55;
    color: #44403c;
  }
  .hcp-stats {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.65rem;
    margin: 1.1rem 0;
  }
  @media (min-width: 640px) {
    .hcp-stats {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
  .hcp-stats div {
    border: 1px solid #e7e5e4;
    border-radius: 0.75rem;
    background: #fafaf9;
    padding: 0.7rem 0.8rem;
  }
  .hcp-stats dt {
    font-size: 0.68rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #78716c;
  }
  .hcp-stats dd {
    margin-top: 0.2rem;
    font-size: 1.4rem;
    font-weight: 500;
    color: #0c0a09;
  }
  .hcp-msg__k {
    margin-top: 0.9rem;
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent, #1f4d3a);
  }
  .hcp-msg ul,
  .hcp-msg ol {
    margin: 0.35rem 0 0;
    padding: 0;
    list-style: none;
  }
  .hcp-msg li {
    position: relative;
    margin-top: 0.35rem;
    padding: 0.45rem 0.6rem;
    border-radius: 0.5rem;
    background: #f5f5f4;
    font-size: 0.875rem;
    line-height: 1.45;
    color: #292524;
  }
  .hcp-rank__v {
    display: inline-block;
    min-width: 4.5rem;
    margin-right: 0.35rem;
    font-weight: 600;
    color: #0c0a09;
    font-variant-numeric: tabular-nums;
  }
  .hcp-card__foot {
    margin-top: 1rem;
    font-size: 0.75rem;
    color: #78716c;
  }
  .hcp-pill {
    display: inline-block;
    margin-left: 0.35rem;
    border-radius: 9999px;
    background: var(--accent, #1f4d3a);
    color: #fff;
    font-size: 0.65rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 0.1rem 0.45rem;
    vertical-align: middle;
  }
  .hcp-pill--warn {
    background: #9a3412;
  }
  .hcp-arch__intro,
  .hcp-arch__stop,
  .hcp-flow__d {
    font-size: 0.875rem;
    line-height: 1.55;
    color: #44403c;
  }
  .hcp-arch__stop {
    margin-top: 1.1rem;
    border-radius: 0.75rem;
    border: 1px solid #d6d3d1;
    background: #fafaf9;
    padding: 0.8rem 0.9rem;
  }
  .hcp-flow {
    margin: 1.1rem 0 0;
    padding: 0;
    list-style: none;
  }
  .hcp-flow__step {
    display: flex;
    gap: 0.85rem;
    align-items: flex-start;
    border: 1px solid #e7e5e4;
    border-radius: 0.85rem;
    background: #fafaf9;
    padding: 0.85rem 0.95rem;
  }
  .hcp-flow__n {
    flex: 0 0 1.6rem;
    height: 1.6rem;
    border-radius: 9999px;
    background: var(--accent, #1f4d3a);
    color: #fff;
    font-size: 0.75rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }
  .hcp-flow__t {
    font-size: 0.9rem;
    font-weight: 500;
    color: #0c0a09;
  }
  .hcp-flow__branch {
    display: flex;
    justify-content: center;
    height: 1.1rem;
  }
  .hcp-flow__branch span {
    width: 1px;
    background: #a8a29e;
  }
  .hcp-flow__split {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.6rem;
  }
  @media (min-width: 768px) {
    .hcp-flow__split {
      grid-template-columns: 1fr auto 1fr;
      align-items: stretch;
    }
  }
  .hcp-flow__card {
    border: 1px solid #e7e5e4;
    border-radius: 0.85rem;
    background: #fff;
    padding: 0.85rem 0.95rem;
  }
  .hcp-flow__or {
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #78716c;
  }
</style>

<script is:inline>
  (function () {
    var root = document.querySelector("[data-hcp-preview]");
    if (!root) return;
    var tabs = Array.prototype.slice.call(root.querySelectorAll('[role="tab"]'));
    var panels = Array.prototype.slice.call(root.querySelectorAll('[role="tabpanel"]'));
    function activate(name, focusTab) {
      tabs.forEach(function (tab) {
        var on = tab.getAttribute("data-tab") === name;
        tab.classList.toggle("is-active", on);
        tab.setAttribute("aria-selected", on ? "true" : "false");
        tab.tabIndex = on ? 0 : -1;
        if (on && focusTab) tab.focus();
      });
      panels.forEach(function (panel) {
        var on = panel.getAttribute("data-panel") === name;
        panel.classList.toggle("is-active", on);
        if (on) panel.removeAttribute("hidden");
        else panel.setAttribute("hidden", "");
      });
    }
    tabs.forEach(function (tab, i) {
      tab.addEventListener("click", function () {
        activate(tab.getAttribute("data-tab"), false);
      });
      tab.addEventListener("keydown", function (event) {
        var next = i;
        if (event.key === "ArrowRight" || event.key === "ArrowDown") next = (i + 1) % tabs.length;
        else if (event.key === "ArrowLeft" || event.key === "ArrowUp") next = (i - 1 + tabs.length) % tabs.length;
        else if (event.key === "Home") next = 0;
        else if (event.key === "End") next = tabs.length - 1;
        else return;
        event.preventDefault();
        activate(tabs[next].getAttribute("data-tab"), true);
      });
    });
  })();
</script>
