---
import { siteConfig } from "../config";

const ventures = siteConfig.ventures ?? [];
---

{
  ventures.length > 0 && (
    <section id="ventures" class="anchor border-b border-stone-200">
      <div class="mx-auto grid max-w-6xl grid-cols-1 gap-8 px-6 py-16 sm:px-10 lg:grid-cols-12 lg:gap-16 lg:py-24">
        <div class="lg:col-span-4">
          <h2 class="text-3xl font-medium tracking-tight text-stone-950 sm:text-4xl lg:text-5xl">
            Ventures
          </h2>
          <div
            class="mt-3 h-1 w-14 rounded-full"
            style={`background-color: ${siteConfig.accentColor}`}
          />
        </div>

        <div class="grid gap-4 lg:col-span-8">
          {ventures.map((venture) => (
            <article class="rounded-2xl border border-stone-200 bg-white p-5 sm:p-6">
              <p
                class="text-xs uppercase tracking-[0.16em]"
                style={`color: ${siteConfig.accentColor}`}
              >
                {venture.role}
              </p>
              <h3 class="mt-2 text-xl font-medium tracking-tight text-stone-950">
                {venture.name}
              </h3>
              <p class="mt-3 text-sm leading-relaxed text-stone-700 sm:text-base">
                {venture.summary}
              </p>
              <a
                href={venture.url}
                target="_blank"
                rel="noopener noreferrer"
                class="mt-4 inline-block text-sm text-stone-950 underline decoration-stone-300 underline-offset-4 hover:decoration-[var(--accent)]"
              >
                {venture.urlLabel}
              </a>
            </article>
          ))}
        </div>
      </div>
    </section>
  )
}
