---
import { siteConfig } from "../config";

const studies = siteConfig.caseStudies ?? [];
---

{
  studies.length > 0 && (
    <section id="case-studies" class="anchor border-b border-stone-200">
      <div class="mx-auto grid max-w-6xl grid-cols-1 gap-8 px-6 py-16 sm:px-10 lg:grid-cols-12 lg:gap-16 lg:py-24">
        <div class="lg:col-span-4">
          <h2 class="text-3xl font-medium tracking-tight text-stone-950 sm:text-4xl lg:text-5xl">
            Case studies
          </h2>
          <div
            class="mt-3 h-1 w-14 rounded-full"
            style={`background-color: ${siteConfig.accentColor}`}
          />
          <p class="mt-6 max-w-xs text-sm leading-relaxed text-stone-600">
            Problem, approach, stack, status, and what's next.
          </p>
        </div>

        <div class="space-y-10 lg:col-span-8">
          {studies.map((study, index) => (
            <article class="overflow-hidden rounded-2xl border border-stone-200 bg-white">
              <div class="p-5 sm:p-8">
                <div class="flex items-start justify-between gap-4">
                  <p
                    class="text-xs uppercase tracking-[0.18em]"
                    style={`color: ${siteConfig.accentColor}`}
                  >
                    {String(index + 1).padStart(2, "0")}
                  </p>
                  <p class="rounded-full border border-stone-300 px-2.5 py-1 text-[11px] uppercase tracking-[0.14em] text-stone-700">
                    {study.label}
                  </p>
                </div>
                <h3 class="mt-4 text-2xl font-medium tracking-tight text-stone-950 sm:text-3xl">
                  {study.name}
                </h3>
                <p class="mt-3 max-w-2xl text-sm leading-relaxed text-stone-600 sm:text-base">
                  {study.summary}
                </p>
                {study.url && (
                  <a
                    href={study.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="mt-4 inline-block text-sm text-stone-950 underline decoration-stone-300 underline-offset-4 hover:decoration-[var(--accent)]"
                  >
                    {study.urlLabel ?? study.url}
                  </a>
                )}
              </div>

              {study.image && (
                <figure class="border-t border-stone-200">
                  <img
                    src={study.image.src}
                    alt={study.image.alt}
                    width={study.image.width}
                    height={study.image.height}
                    class="h-auto w-full"
                    loading={index === 0 ? "eager" : "lazy"}
                  />
                  {study.image.caption && (
                    <figcaption class="px-5 py-4 text-xs leading-relaxed text-stone-500 sm:px-8">
                      {study.image.caption}
                    </figcaption>
                  )}
                </figure>
              )}

              {study.imageTodo && (
                <p class="mx-5 mb-2 border border-dashed border-stone-400 bg-stone-50 px-4 py-4 text-sm leading-relaxed text-stone-800 sm:mx-8">
                  {study.imageTodo}
                </p>
              )}

              <dl class="px-5 pb-2 sm:px-8">
                <div class="grid grid-cols-1 gap-2 border-t border-stone-200 py-5 sm:grid-cols-12 sm:gap-6">
                  <dt class="text-xs uppercase tracking-[0.16em] text-stone-500 sm:col-span-3">
                    Problem
                  </dt>
                  <dd class="text-sm leading-relaxed text-stone-700 sm:col-span-9 sm:text-base">
                    {study.problem}
                  </dd>
                </div>
                <div class="grid grid-cols-1 gap-2 border-t border-stone-200 py-5 sm:grid-cols-12 sm:gap-6">
                  <dt class="text-xs uppercase tracking-[0.16em] text-stone-500 sm:col-span-3">
                    Approach
                  </dt>
                  <dd class="text-sm leading-relaxed text-stone-700 sm:col-span-9 sm:text-base">
                    {study.approach}
                  </dd>
                </div>
                <div class="grid grid-cols-1 gap-2 border-t border-stone-200 py-5 sm:grid-cols-12 sm:gap-6">
                  <dt class="text-xs uppercase tracking-[0.16em] text-stone-500 sm:col-span-3">
                    Stack
                  </dt>
                  <dd class="sm:col-span-9">
                    <ul class="flex flex-wrap gap-2">
                      {study.stack.map((item) => (
                        <li class="rounded-md bg-stone-900 px-2.5 py-1 text-xs text-white">
                          {item}
                        </li>
                      ))}
                    </ul>
                  </dd>
                </div>
                <div class="grid grid-cols-1 gap-2 border-t border-stone-200 py-5 sm:grid-cols-12 sm:gap-6">
                  <dt class="text-xs uppercase tracking-[0.16em] text-stone-500 sm:col-span-3">
                    Status
                  </dt>
                  <dd class="text-sm leading-relaxed text-stone-700 sm:col-span-9 sm:text-base">
                    {study.status}
                  </dd>
                </div>
                <div class="grid grid-cols-1 gap-2 border-t border-stone-200 py-5 sm:grid-cols-12 sm:gap-6">
                  <dt class="text-xs uppercase tracking-[0.16em] text-stone-500 sm:col-span-3">
                    What's next
                  </dt>
                  <dd
                    class:list={[
                      "text-sm leading-relaxed sm:col-span-9 sm:text-base",
                      study.next.startsWith("TODO:")
                        ? "border border-dashed border-stone-400 bg-stone-50 px-3 py-3 text-stone-800"
                        : "text-stone-700",
                    ]}
                  >
                    {study.next}
                  </dd>
                </div>
              </dl>
            </article>
          ))}
        </div>
      </div>
    </section>
  )
}
