---
const guardrails = [
  {
    name: "Draft-first approvals",
    description: "A human approves every customer-facing send.",
    nextStep: "Route customer-facing drafts to a human approver and verify that unapproved drafts cannot send.",
  },
  {
    name: "Test mode and dry-run defaults",
    description: "Test mode (testMode) and dry-run are on by default.",
    nextStep: "Turn on test mode and dry-run by default, then verify that a test run cannot send messages or write to live records.",
  },
  {
    name: "Eval coverage",
    description: "Pre-launch tests cover edge cases in the workflow.",
    nextStep: "Write and run pre-launch tests for edge cases such as missing context and connector failures.",
  },
  {
    name: "Error alerting",
    description: "Workflow failures alert the person responsible for responding.",
    nextStep: "Trigger a test failure and confirm that the responsible person receives the alert.",
  },
  {
    name: "Owner sign-off",
    description: "The responsible owner has signed the Go-Live checklist.",
    nextStep: "Review the Go-Live checklist with the responsible owner and record their sign-off.",
  },
];
---

<section id="agent-readiness" aria-labelledby="readiness-title" class="flex min-w-0 flex-col rounded-2xl border border-stone-200 bg-white p-5 sm:p-6">
  <h2 id="readiness-title" class="text-lg font-medium tracking-tight text-stone-950">
    AI Agent Production Readiness Checklist
  </h2>
  <p class="mt-3 text-sm leading-relaxed text-stone-600">
    Rate each Production Guardrail for your workflow. Each guardrail marked “In place” counts toward the score.
  </p>
  <div class="mt-5 space-y-4 text-sm text-stone-700">
    {guardrails.map(({ name, description, nextStep }, index) => (
      <div>
        <label for={`guardrail-${index}`} class="block font-medium">{name}</label>
        <p id={`guardrail-note-${index}`} class="mt-1 text-stone-600">{description}</p>
        <select
          id={`guardrail-${index}`}
          aria-describedby={`guardrail-note-${index}`}
          data-next-step={nextStep}
          class="mt-2 w-full rounded-lg border border-stone-300 bg-white px-3 py-2 text-stone-950 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--accent)]"
        >
          <option value="not-started">Not started</option>
          <option value="in-progress">In progress</option>
          <option value="in-place">In place</option>
        </select>
      </div>
    ))}
  </div>
  <p class="mt-5 text-sm leading-relaxed text-stone-600">
    This is a self-assessment. Prewired AI does not certify or audit your workflow through this checklist.
  </p>
  <div class="mt-auto pt-5">
    <div aria-live="polite" aria-atomic="true" class="rounded-xl border border-stone-200 bg-stone-50 p-4 text-sm">
      <p class="text-stone-600">Guardrails in place</p>
      <p id="readiness-score" class="font-medium text-[var(--accent)]">0 of {guardrails.length} · Not ready</p>
      <p class="mt-3 text-stone-600">Recommended next step</p>
      <p id="readiness-next" class="mt-1 text-stone-950">{guardrails[0].nextStep}</p>
    </div>
  </div>
</section>

<script>
  const readiness = document.querySelector("#agent-readiness");
  const ratings = readiness?.querySelectorAll<HTMLSelectElement>("select[data-next-step]");
  const score = readiness?.querySelector("#readiness-score");
  const nextStep = readiness?.querySelector("#readiness-next");

  if (readiness && ratings?.length && score && nextStep) {
    const guardrails = Array.from(ratings);

    const update = () => {
      const inPlace = guardrails.filter((rating) => rating.value === "in-place").length;
      const pending = guardrails.find((rating) => rating.value === "not-started")
        ?? guardrails.find((rating) => rating.value === "in-progress");
      let band = "Not ready";
      if (inPlace === guardrails.length) {
        band = "Ready to review go-live";
      } else if (inPlace === guardrails.length - 1) {
        band = "Almost ready";
      }

      score.textContent = `${inPlace} of ${guardrails.length} · ${band}`;
      nextStep.textContent = pending?.dataset.nextStep
        ?? "Review the signed Go-Live checklist and confirm who will monitor the first live runs.";
    };

    readiness.addEventListener("change", update);
    update();
  }
</script>
