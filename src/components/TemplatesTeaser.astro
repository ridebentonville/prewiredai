---
import { siteConfig } from "../config";
import { templatePacks, templatesTeaser } from "../templates";
---

{
  templatePacks.length > 0 && (
    <section id="templates" class="anchor border-b border-stone-200">
      <div class="mx-auto grid max-w-6xl grid-cols-1 gap-8 px-6 py-16 sm:px-10 lg:grid-cols-12 lg:gap-16 lg:py-24">
        <div class="lg:col-span-4">
          <h2 class="text-3xl font-medium tracking-tight text-stone-950 sm:text-4xl lg:text-5xl">
            {templatesTeaser.heading}
          </h2>
          <div
            class="mt-3 h-1 w-14 rounded-full"
            style={`background-color: ${siteConfig.accentColor}`}
          />
        </div>
        <div class="lg:col-span-8">
          <p class="max-w-xl text-base leading-relaxed text-stone-700">
            {templatesTeaser.summary}
          </p>
          <ul class="mt-5 grid grid-cols-1 gap-2 text-sm text-stone-700 sm:grid-cols-2">
            {templatePacks.map((pack) => (
              <li class="flex gap-2">
                <span aria-hidden="true" style={`color: ${siteConfig.accentColor}`}>—</span>
                <span>{pack.name}</span>
              </li>
            ))}
          </ul>
          <p class="mt-6 text-sm">
            <a
              href="/templates"
              class="text-stone-950 underline decoration-stone-300 underline-offset-4 hover:decoration-[var(--accent)]"
            >
              {templatesTeaser.linkLabel} →
            </a>
          </p>
        </div>
      </div>
    </section>
  )
}
