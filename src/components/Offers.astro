---
import { siteConfig } from "../config";

const offers = siteConfig.offers ?? [];
const email = siteConfig.social.email;
---

{
  offers.length > 0 && (
    <section id="work-with-me" class="anchor border-b border-stone-200">
      <div class="mx-auto grid max-w-6xl grid-cols-1 gap-8 px-6 py-16 sm:px-10 lg:grid-cols-12 lg:gap-16 lg:py-24">
        <div class="lg:col-span-4">
          <h2 class="text-3xl font-medium tracking-tight text-stone-950 sm:text-4xl lg:text-5xl">
            Work with me
          </h2>
          <div
            class="mt-3 h-1 w-14 rounded-full"
            style={`background-color: ${siteConfig.accentColor}`}
          />
          <p class="mt-6 max-w-xs text-sm leading-relaxed text-stone-600">
            Fixed-scope builds, retainers, and done-for-you AI agent installs. {siteConfig.openTo}
          </p>
        </div>

        <div class="grid grid-cols-1 gap-6 md:grid-cols-3 lg:col-span-8 lg:grid-cols-1">
          {offers.map((offer) => (
            <article class="flex flex-col rounded-2xl border border-stone-200 bg-white p-5 sm:p-6">
              <h3 class="text-lg font-medium tracking-tight text-stone-950">
                {offer.name}
              </h3>
              <p class="mt-3 text-sm leading-relaxed text-stone-600">
                {offer.summary}
              </p>
              <ul class="mt-4 space-y-2 text-sm text-stone-700">
                {offer.includes.map((item) => (
                  <li class="flex gap-2">
                    <span aria-hidden="true" style={`color: ${siteConfig.accentColor}`}>—</span>
                    <span>{item}</span>
                  </li>
                ))}
              </ul>
              <p class="mt-auto pt-5 text-xs uppercase tracking-[0.16em] text-stone-500">
                {offer.price?.trim() ? offer.price : "Pricing on request"}
              </p>
            </article>
          ))}
          {email && (
            <p class="text-sm text-stone-700 md:col-span-3 lg:col-span-1">
              <a
                href={`mailto:${email}?subject=${encodeURIComponent("Project inquiry")}`}
                class="underline decoration-stone-300 underline-offset-4 hover:decoration-[var(--accent)]"
              >
                Email me about a project
              </a>
            </p>
          )}
        </div>
      </div>
    </section>
  )
}
