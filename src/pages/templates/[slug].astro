---
import { existsSync } from "node:fs";
import { join } from "node:path";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import PageHead from "../../components/PageHead.astro";
import TierTable from "../../components/TierTable.astro";
import ServiceTitanLivePreview from "../../components/ServiceTitanLivePreview.astro";
import { siteConfig } from "../../config";
import {
  categoryLabel,
  getPack,
  PRICE_PENDING,
  setupAgentNote,
  sharedGuardrails,
  templatePacks,
  waitlistHref,
  type TemplatePack,
} from "../../templates";
import "../../styles/global.css";

export function getStaticPaths() {
  return templatePacks.map((pack) => ({ params: { slug: pack.slug } }));
}

const { slug } = Astro.params;
const pack = getPack(slug!) as TemplatePack;
const accent = siteConfig.accentColor;

const diagramSrc = `/diagrams/${pack.slug}.html`;
const diagramExists =
  pack.diagram === true &&
  existsSync(join(process.cwd(), "public", "diagrams", `${pack.slug}.html`));

const related = (pack.related ?? [])
  .map((s) => getPack(s))
  .filter((p): p is TemplatePack => Boolean(p));

const title = `${pack.name} | Prewired AI template pack (draft)`;
const description = `${pack.summary} ${pack.free ? "Free." : `${PRICE_PENDING}.`} Draft, not for sale yet.`;
const workflowWord = pack.workflows.length === 1 ? "n8n workflow" : "n8n workflows";
const email = siteConfig.social.email;
const schedulingUrl = siteConfig.schedulingUrl?.trim();
---

<html lang="en">
  <head>
    <PageHead title={title} description={description} path={`/templates/${pack.slug}`} />
  </head>
  <body style={`--accent: ${accent}`}>
    <Header />
    <main id="top">
      <section class="border-b border-stone-200">
        <div class="mx-auto max-w-6xl px-6 py-16 sm:px-10 lg:py-20">
          <nav aria-label="Breadcrumb" class="text-sm text-stone-600">
            <a href="/templates" class="underline decoration-stone-300 underline-offset-4 hover:decoration-[var(--accent)]">
              ← All template packs
            </a>
          </nav>
          <div class="mt-8 flex flex-wrap items-center gap-2">
            <span class="text-xs uppercase tracking-[0.16em] text-stone-500">{categoryLabel(pack.category)}</span>
            <span class="text-xs text-stone-400" aria-hidden="true">·</span>
            <span class="text-xs text-stone-500">{pack.version} draft</span>
            {
              pack.badge && (
                <span
                  class="rounded-full px-2.5 py-0.5 text-xs font-semibold uppercase tracking-[0.12em] text-white"
                  style={`background-color: ${accent}`}
                >
                  {pack.badge}
                </span>
              )
            }
            {
              pack.free ? (
                <span
                  class="rounded-full px-2.5 py-0.5 text-xs font-semibold uppercase tracking-[0.12em] text-white"
                  style={`background-color: ${accent}`}
                >
                  Free
                </span>
              ) : (
                <span class="rounded-full border border-stone-300 px-2.5 py-0.5 text-xs text-stone-600">
                  {PRICE_PENDING}
                </span>
              )
            }
          </div>
          <h1 class="mt-3 text-3xl font-medium tracking-tight text-stone-950 sm:text-4xl lg:text-5xl">
            {pack.name}
          </h1>
          <div class="mt-3 h-1 w-14 rounded-full" style={`background-color: ${accent}`} />
          <p class="mt-6 max-w-3xl text-lg leading-relaxed text-stone-800">{pack.headline}</p>
          <p class="mt-4 max-w-2xl text-sm leading-relaxed text-stone-600">
            <span class="font-medium text-stone-700">Who it's for:</span> {pack.whoFor}
          </p>
          <div class="mt-8 flex flex-col items-start gap-3 sm:flex-row sm:flex-wrap sm:items-center sm:gap-4">
            {
              schedulingUrl && (
                <a
                  href={schedulingUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center rounded-full px-4 py-2 text-sm font-medium text-white hover:opacity-90 focus-visible:outline-2 focus-visible:outline-offset-2"
                  style={`background-color: ${accent}; outline-color: ${accent}`}
                >
                  Book a 15-min ops audit
                </a>
              )
            }
            {
              email && (
                <a
                  href="#waitlist"
                  class:list={[
                    "inline-flex items-center rounded-full px-4 py-2 text-sm font-medium focus-visible:outline-2 focus-visible:outline-offset-2",
                    schedulingUrl
                      ? "border border-stone-300 bg-white text-stone-950 hover:border-stone-500"
                      : "text-white hover:opacity-90",
                  ]}
                  style={schedulingUrl ? undefined : `background-color: ${accent}; outline-color: ${accent}`}
                >
                  {pack.free ? "Get the free pack (waitlist)" : "Join the waitlist"}
                </a>
              )
            }
            <p class="text-xs uppercase tracking-[0.16em] text-stone-500">Not for sale yet</p>
          </div>
        </div>
      </section>

      {
        pack.callouts && pack.callouts.length > 0 && (
          <section class="border-b border-stone-200" aria-label="Why this pack">
            <div class="mx-auto max-w-6xl px-6 py-12 sm:px-10">
              <div class:list={["grid grid-cols-1 gap-4", pack.callouts.length > 1 && "lg:grid-cols-2"]}>
                {pack.callouts.map((c) => (
                  <div class="rounded-2xl border border-stone-200 bg-white p-6">
                    <h2 class="text-lg font-medium tracking-tight text-stone-950">{c.title}</h2>
                    <div class="mt-3 h-1 w-10 rounded-full" style={`background-color: ${accent}`} />
                    <p class="mt-4 text-sm leading-relaxed text-stone-700">{c.body}</p>
                    {c.items && c.items.length > 0 && (
                      <ul class="mt-4 space-y-3">
                        {c.items.map((item) => (
                          <li>
                            <p class="text-sm font-medium text-stone-950">{item.heading}</p>
                            <p class="mt-1 text-sm leading-relaxed text-stone-600">{item.body}</p>
                          </li>
                        ))}
                      </ul>
                    )}
                  </div>
                ))}
              </div>
            </div>
          </section>
        )
      }

      {pack.slug === "servicetitan-dispatch-copilot" && <ServiceTitanLivePreview />}

      <section class="border-b border-stone-200" aria-labelledby="does-heading">
        <div class="mx-auto grid max-w-6xl grid-cols-1 gap-8 px-6 py-12 sm:px-10 lg:grid-cols-12 lg:gap-16">
          <div class="lg:col-span-4">
            <h2 id="does-heading" class="text-xl font-medium tracking-tight text-stone-950">What it does</h2>
            <div class="mt-3 h-1 w-10 rounded-full" style={`background-color: ${accent}`} />
          </div>
          <ol class="space-y-3 text-sm leading-relaxed text-stone-700 lg:col-span-8">
            {
              pack.whatItDoes.map((item, i) => (
                <li class="flex gap-3">
                  <span class="w-5 shrink-0 text-stone-400" aria-hidden="true">{i + 1}.</span>
                  <span>{item}</span>
                </li>
              ))
            }
          </ol>
        </div>
      </section>

      <section class="border-b border-stone-200" aria-labelledby="inside-heading">
        <div class="mx-auto grid max-w-6xl grid-cols-1 gap-8 px-6 py-12 sm:px-10 lg:grid-cols-12 lg:gap-16">
          <div class="lg:col-span-4">
            <h2 id="inside-heading" class="text-xl font-medium tracking-tight text-stone-950">What's inside</h2>
            <div class="mt-3 h-1 w-10 rounded-full" style={`background-color: ${accent}`} />
            <dl class="mt-6 grid grid-cols-2 gap-4">
              <div class="rounded-2xl border border-stone-200 bg-white p-4">
                <dt class="text-xs uppercase tracking-[0.14em] text-stone-500">Workflows</dt>
                <dd class="mt-1 text-2xl font-medium text-stone-950">{pack.workflows.length}</dd>
              </div>
              <div class="rounded-2xl border border-stone-200 bg-white p-4">
                <dt class="text-xs uppercase tracking-[0.14em] text-stone-500">Executable nodes</dt>
                <dd class="mt-1 text-2xl font-medium text-stone-950">{pack.totalNodes}</dd>
              </div>
            </dl>
            <p class="mt-3 text-xs leading-relaxed text-stone-500">
              Counted from the shipped n8n JSON, excluding sticky notes ({pack.totalNodesWithNotes} including canvas notes).
            </p>
          </div>
          <div class="space-y-8 lg:col-span-8">
            <div>
              <h3 class="text-sm font-medium text-stone-950">
                {pack.workflows.length} {workflowWord}
              </h3>
              <ul class="mt-3 divide-y divide-stone-200 rounded-2xl border border-stone-200 bg-white">
                {
                  pack.workflows.map((wf) => (
                    <li class="flex flex-col gap-1 p-4 sm:flex-row sm:items-baseline sm:justify-between sm:gap-6">
                      <div>
                        <p class="text-sm font-medium text-stone-900">{wf.name}</p>
                        <p class="mt-1 text-sm leading-relaxed text-stone-600">{wf.description}</p>
                      </div>
                      <p class="shrink-0 text-sm text-stone-700">{wf.nodes} executable nodes</p>
                    </li>
                  ))
                }
              </ul>
              {pack.kitNote && <p class="mt-3 text-sm leading-relaxed text-stone-600">{pack.kitNote}</p>}
            </div>

            <div>
              <h3 class="text-sm font-medium text-stone-950">Defaults on import (test mode / dry-run)</h3>
              <ul class="mt-3 space-y-2 text-sm leading-relaxed text-stone-700">
                {
                  pack.defaults.map((d) => (
                    <li class="flex gap-2">
                      <span aria-hidden="true" style={`color: ${accent}`}>—</span>
                      <span>{d}</span>
                    </li>
                  ))
                }
              </ul>
              <p class="mt-3 rounded-xl border border-stone-200 bg-stone-50 p-3 text-sm leading-relaxed text-stone-700">
                <span class="font-medium">Written in test mode?</span> {pack.testModeWrites}
              </p>
            </div>

            <div>
              <h3 class="text-sm font-medium text-stone-950">Included files</h3>
              <ul class="mt-3 space-y-2 text-sm leading-relaxed text-stone-700">
                {
                  pack.included.map((d) => (
                    <li class="flex gap-2">
                      <span aria-hidden="true" style={`color: ${accent}`}>—</span>
                      <span>{d}</span>
                    </li>
                  ))
                }
              </ul>
            </div>

            <div class="rounded-2xl border border-stone-200 bg-white p-4">
              <p class="text-sm font-medium text-stone-950">Setup Agent compatible</p>
              <p class="mt-1 text-sm leading-relaxed text-stone-600">{setupAgentNote}</p>
            </div>
          </div>
        </div>
      </section>

      {
        pack.diagram && (
          <section class="border-b border-stone-200" aria-labelledby="diagram-heading">
            <div class="mx-auto max-w-6xl px-6 py-12 sm:px-10">
              <h2 id="diagram-heading" class="text-xl font-medium tracking-tight text-stone-950">
                How the workflow runs
              </h2>
              <div class="mt-3 h-1 w-10 rounded-full" style={`background-color: ${accent}`} />
              {diagramExists ? (
                <>
                  <div class="mt-6 overflow-hidden rounded-2xl border border-stone-200 bg-white">
                    <iframe
                      id="workflow-diagram"
                      src={diagramSrc}
                      title={`Interactive workflow diagram: ${pack.name}`}
                      loading="eager"
                      class="block w-full min-h-[560px] h-[720px]"
                    />
                  </div>
                  <script is:inline>
                    (function () {
                      var TYPE = "prewired-diagram-height";
                      window.addEventListener("message", function (event) {
                        var data = event.data || {};
                        if (data.type !== TYPE || typeof data.height !== "number") return;
                        var iframe = document.getElementById("workflow-diagram");
                        if (!iframe) return;
                        var next = Math.max(560, Math.min(2000, Math.ceil(data.height)));
                        iframe.style.height = next + "px";
                      });
                    })();
                  </script>
                  <noscript>
                    <p class="mt-3 text-sm text-stone-700">
                      <a href={diagramSrc} class="underline underline-offset-4">Open the workflow diagram</a>
                    </p>
                  </noscript>
                  <p class="mt-3 text-sm">
                    <a
                      href={diagramSrc}
                      target="_blank"
                      rel="noopener"
                      class="text-stone-700 underline decoration-stone-300 underline-offset-4 hover:decoration-[var(--accent)]"
                    >
                      Open the diagram in a new tab
                    </a>
                  </p>
                </>
              ) : (
                <div class="mt-6 flex min-h-[200px] items-center justify-center rounded-2xl border border-dashed border-stone-300 bg-white p-8 text-center">
                  <p class="text-sm text-stone-500">Interactive workflow diagram coming soon.</p>
                </div>
              )}
            </div>
          </section>
        )
      }

      <section class="border-b border-stone-200" aria-labelledby="guardrails-heading">
        <div class="mx-auto grid max-w-6xl grid-cols-1 gap-8 px-6 py-12 sm:px-10 lg:grid-cols-12 lg:gap-16">
          <div class="lg:col-span-4">
            <h2 id="guardrails-heading" class="text-xl font-medium tracking-tight text-stone-950">
              Production Guardrails
            </h2>
            <div class="mt-3 h-1 w-10 rounded-full" style={`background-color: ${accent}`} />
          </div>
          <div class="space-y-8 lg:col-span-8">
            <div>
              <h3 class="text-sm font-medium text-stone-950">In this pack</h3>
              <ul class="mt-3 space-y-2 text-sm leading-relaxed text-stone-700">
                {
                  pack.guardrails.map((g) => (
                    <li class="flex gap-2">
                      <span aria-hidden="true" style={`color: ${accent}`}>—</span>
                      <span>{g}</span>
                    </li>
                  ))
                }
              </ul>
            </div>
            <div class="rounded-2xl border border-stone-300 bg-white p-5">
              <h3 class="text-sm font-medium text-stone-950">Hard stop before the first live action</h3>
              <p class="mt-2 text-sm leading-relaxed text-stone-700">{pack.hardStop}</p>
            </div>
            <div>
              <h3 class="text-sm font-medium text-stone-950">What this pack will not do</h3>
              <ul class="mt-3 space-y-2 text-sm leading-relaxed text-stone-700">
                {
                  pack.willNot.map((w) => (
                    <li class="flex gap-2">
                      <span aria-hidden="true" class="text-stone-400">×</span>
                      <span>{w}</span>
                    </li>
                  ))
                }
              </ul>
            </div>
            <details class="rounded-2xl border border-stone-200 bg-white p-5">
              <summary class="cursor-pointer text-sm font-medium text-stone-950">
                Shared guardrails in every Prewired AI pack ({sharedGuardrails.length})
              </summary>
              <ol class="mt-4 space-y-2 text-sm leading-relaxed text-stone-700">
                {
                  sharedGuardrails.map((g, i) => (
                    <li class="flex gap-3">
                      <span class="w-6 shrink-0 text-stone-400">{i + 1}.</span>
                      <span><span class="font-medium">{g.title}.</span> {g.body}</span>
                    </li>
                  ))
                }
              </ol>
            </details>
          </div>
        </div>
      </section>

      {
        pack.faq.length > 0 && (
          <section class="border-b border-stone-200" aria-labelledby="faq-heading">
            <div class="mx-auto grid max-w-6xl grid-cols-1 gap-8 px-6 py-12 sm:px-10 lg:grid-cols-12 lg:gap-16">
              <div class="lg:col-span-4">
                <h2 id="faq-heading" class="text-xl font-medium tracking-tight text-stone-950">FAQ</h2>
                <div class="mt-3 h-1 w-10 rounded-full" style={`background-color: ${accent}`} />
              </div>
              <dl class="divide-y divide-stone-200 rounded-2xl border border-stone-200 bg-white lg:col-span-8">
                {pack.faq.map((f) => (
                  <div class="p-5">
                    <dt class="text-sm font-medium text-stone-950">{f.q}</dt>
                    <dd class="mt-2 text-sm leading-relaxed text-stone-600">{f.a}</dd>
                  </div>
                ))}
              </dl>
            </div>
          </section>
        )
      }

      <section id="waitlist" class="anchor border-b border-stone-200" aria-labelledby="waitlist-heading">
        <div class="mx-auto max-w-6xl px-6 py-12 sm:px-10">
          <h2 id="waitlist-heading" class="text-xl font-medium tracking-tight text-stone-950">
            {pack.free ? "Get the free pack" : "Join the waitlist"}
          </h2>
          <div class="mt-3 h-1 w-10 rounded-full" style={`background-color: ${accent}`} />
          <p class="mt-4 max-w-2xl text-sm leading-relaxed text-stone-600">
            {
              pack.free
                ? "Manager Digest will be free. It is not published yet, so there is no download link. Join the email waitlist and you will hear when it is ready."
                : `This pack is a draft and not for sale yet. There is no checkout, and prices are not set. Join the email waitlist and you will hear when ${pack.name} is ready.`
            }
          </p>
          <div class="mt-6">
            <TierTable pack={pack} />
          </div>
          {
            schedulingUrl && (
              <p class="mt-6 max-w-2xl text-sm leading-relaxed text-stone-700">
                Want me to wire this into your CRM in 10 days?
              </p>
            )
          }
          <div class="mt-6 flex flex-col items-start gap-3 sm:flex-row sm:flex-wrap sm:items-center sm:gap-4">
            {
              schedulingUrl && (
                <a
                  href={schedulingUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center rounded-full px-4 py-2 text-sm font-medium text-white hover:opacity-90 focus-visible:outline-2 focus-visible:outline-offset-2"
                  style={`background-color: ${accent}; outline-color: ${accent}`}
                >
                  Book a 15-min ops audit
                </a>
              )
            }
            {
              email && (
                <a
                  href={waitlistHref(email, pack)}
                  class:list={[
                    "inline-flex items-center rounded-full px-4 py-2 text-sm font-medium focus-visible:outline-2 focus-visible:outline-offset-2",
                    schedulingUrl
                      ? "border border-stone-300 bg-white text-stone-950 hover:border-stone-500"
                      : "text-white hover:opacity-90",
                  ]}
                  style={schedulingUrl ? undefined : `background-color: ${accent}; outline-color: ${accent}`}
                >
                  Email to join the waitlist
                </a>
              )
            }
            <span class="text-xs uppercase tracking-[0.16em] text-stone-500">Not for sale yet</span>
          </div>
          <p class="mt-6 max-w-2xl text-xs leading-relaxed text-stone-500">{pack.testingNote} Sample data is fictional.</p>
        </div>
      </section>

      <section aria-label="More packs">
        <div class="mx-auto max-w-6xl px-6 py-12 sm:px-10">
          {
            related.length > 0 && (
              <>
                <h2 id="more-heading" class="text-lg font-medium tracking-tight text-stone-950">Related packs</h2>
                <ul class="mt-4 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
                  {related.map((r) => (
                    <li>
                      <a
                        href={`/templates/${r.slug}`}
                        class="block h-full rounded-2xl border border-stone-200 bg-white p-4 hover:border-[var(--accent)]"
                      >
                        <p class="text-xs uppercase tracking-[0.14em] text-stone-500">{categoryLabel(r.category)}</p>
                        <p class="mt-1 text-sm font-medium text-stone-950">{r.name}</p>
                        <p class="mt-2 text-sm leading-relaxed text-stone-600">{r.summary}</p>
                      </a>
                    </li>
                  ))}
                </ul>
              </>
            )
          }
          <p class:list={["flex flex-wrap gap-x-6 gap-y-2 text-sm", related.length > 0 && "mt-8"]}>
            <a href="/templates" class="text-stone-950 underline decoration-stone-300 underline-offset-4 hover:decoration-[var(--accent)]">
              ← All template packs
            </a>
            <a href="/calculators" class="text-stone-950 underline decoration-stone-300 underline-offset-4 hover:decoration-[var(--accent)]">
              Estimate automation value →
            </a>
          </p>
        </div>
      </section>
    </main>
    <Footer />
  </body>
</html>
