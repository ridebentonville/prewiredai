---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { siteConfig } from "../config";
import AutomationRoi from "../components/AutomationRoi.astro";
import AgentReadiness from "../components/AgentReadiness.astro";
import "../styles/global.css";

const title = "Automation ROI & AI Agent Readiness Calculators | Prewired AI";
const description =
  "Estimate the value of time saved by automation and assess your AI agent’s Production Guardrails before go-live.";
const canonical = Astro.site
  ? new URL("/calculators", Astro.site).href
  : "https://prewiredai.com/calculators";
const ogImageUrl = new URL(siteConfig.ogImage.src, canonical).href;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="theme-color" content={siteConfig.accentColor} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={siteConfig.name} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content={String(siteConfig.ogImage.width)} />
    <meta property="og:image:height" content={String(siteConfig.ogImage.height)} />
    <meta property="og:image:alt" content={siteConfig.ogImage.alt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={siteConfig.ogImage.alt} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
  </head>
  <body style={`--accent: ${siteConfig.accentColor}`}>
    <Header />
    <main id="top">
      <section class="border-b border-stone-200">
        <div class="mx-auto max-w-6xl px-6 py-16 sm:px-10 lg:py-24">
          <h1 class="text-3xl font-medium tracking-tight text-stone-950 sm:text-4xl lg:text-5xl">
            Calculators
          </h1>
          <div
            class="mt-3 h-1 w-14 rounded-full"
            style={`background-color: ${siteConfig.accentColor}`}
          />
          <p class="mt-6 max-w-2xl text-base leading-relaxed text-stone-700">
            Estimate the value of time saved by automation and check your AI agent’s Production Guardrails before go-live.
          </p>
          <noscript>
            <p class="mt-3 text-sm text-stone-700">Enable JavaScript to use these calculators.</p>
          </noscript>
          <div class="mt-10 grid grid-cols-1 gap-6 md:grid-cols-2">
            <AutomationRoi />
            <AgentReadiness />
          </div>
        </div>
      </section>
    </main>
    <Footer />
  </body>
</html>
