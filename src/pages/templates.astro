---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { siteConfig } from "../config";
import { templatePacks, templatesPage } from "../templates";
import "../styles/global.css";

const canonical = Astro.site
  ? new URL("/templates", Astro.site).href
  : "https://prewiredai.com/templates";
const ogImageUrl = new URL(siteConfig.ogImage.src, canonical).href;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={templatesPage.description} />
    <meta name="theme-color" content={siteConfig.accentColor} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={templatesPage.title} />
    <meta property="og:description" content={templatesPage.description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={siteConfig.name} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content={String(siteConfig.ogImage.width)} />
    <meta property="og:image:height" content={String(siteConfig.ogImage.height)} />
    <meta property="og:image:alt" content={siteConfig.ogImage.alt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={templatesPage.title} />
    <meta name="twitter:description" content={templatesPage.description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={siteConfig.ogImage.alt} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    <title>{templatesPage.title}</title>
  </head>
  <body style={`--accent: ${siteConfig.accentColor}`}>
    <Header />
    <main id="top">
      <section class="border-b border-stone-200">
        <div class="mx-auto max-w-6xl px-6 py-16 sm:px-10 lg:py-24">
          <h1 class="text-3xl font-medium tracking-tight text-stone-950 sm:text-4xl lg:text-5xl">
            {templatesPage.heading}
          </h1>
          <div
            class="mt-3 h-1 w-14 rounded-full"
            style={`background-color: ${siteConfig.accentColor}`}
          />
          <p class="mt-6 max-w-2xl text-base leading-relaxed text-stone-700">
            {templatesPage.intro}
          </p>
          <p class="mt-3 max-w-2xl text-sm leading-relaxed text-stone-600">
            {templatesPage.safetyNote}
          </p>
          <p class="mt-3 max-w-2xl text-sm leading-relaxed text-stone-600">
            {templatesPage.priceNote}
          </p>

          <div class="mt-10 grid grid-cols-1 gap-6 md:grid-cols-2">
            {
              templatePacks.map((pack) => (
                <article class="flex flex-col rounded-2xl border border-stone-200 bg-white p-5 sm:p-6">
                  {pack.tag && (
                    <p class="mb-2 text-xs uppercase tracking-[0.16em] text-stone-500">
                      {pack.tag}
                    </p>
                  )}
                  <h2 class="text-lg font-medium tracking-tight text-stone-950">
                    {pack.name}
                  </h2>
                  <p class="mt-3 text-sm leading-relaxed text-stone-600">
                    {pack.summary}
                  </p>
                  <p class="mt-3 text-sm leading-relaxed text-stone-700">
                    <span class="font-medium">Safety first:</span> {pack.safety}
                  </p>
                  <dl class="mt-4 space-y-1 text-sm text-stone-700">
                    {pack.prices.map((p) => (
                      <div class="flex justify-between gap-4">
                        <dt class="text-stone-600">{p.label}</dt>
                        <dd>{p.value}</dd>
                      </div>
                    ))}
                  </dl>
                  <p class="mt-auto pt-5 text-xs uppercase tracking-[0.16em] text-stone-500">
                    {pack.gumroadUrl?.trim() ? (
                      <a
                        href={pack.gumroadUrl}
                        class="underline underline-offset-4 hover:text-[var(--accent)]"
                      >
                        Gumroad
                      </a>
                    ) : (
                      <span aria-disabled="true">Gumroad: Coming soon</span>
                    )}
                  </p>
                </article>
              ))
            }
          </div>

          {
            siteConfig.social.email && (
              <p class="mt-10 text-sm text-stone-700">
                <a
                  href={`mailto:${siteConfig.social.email}?subject=${encodeURIComponent("Templates inquiry")}`}
                  class="underline decoration-stone-300 underline-offset-4 hover:decoration-[var(--accent)]"
                >
                  Email me about the templates
                </a>
              </p>
            )
          }
        </div>
      </section>
    </main>
    <Footer />
  </body>
</html>
