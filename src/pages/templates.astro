---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import PageHead from "../components/PageHead.astro";
import TierTable from "../components/TierTable.astro";
import { siteConfig } from "../config";
import {
  categories,
  categoryLabel,
  packFilters,
  PRICE_PENDING,
  sharedGuardrails,
  setupAgentNote,
  templatePacks,
  templatesPage,
  waitlistHref,
} from "../templates";
import "../styles/global.css";

const accent = siteConfig.accentColor;
const schedulingUrl = siteConfig.schedulingUrl?.trim();
const chipCounts = Object.fromEntries(
  categories.map((c) => [
    c.id,
    templatePacks.filter((p) => packFilters(p).includes(c.id)).length,
  ]),
);
const visibleCategories = categories.filter((c) => chipCounts[c.id] > 0);
const shortGuardrails = sharedGuardrails.slice(0, 9);
---

<html lang="en">
  <head>
    <PageHead
      title={templatesPage.title}
      description={templatesPage.description}
      path="/templates"
    />
  </head>
  <body style={`--accent: ${accent}`}>
    <Header />
    <main id="top">
      <section class="border-b border-stone-200">
        <div class="mx-auto max-w-6xl px-6 py-16 sm:px-10 lg:py-24">
          <p class="text-xs uppercase tracking-[0.16em] text-stone-500">
            Draft catalog · 13 packs for n8n
          </p>
          <h1 class="mt-3 text-3xl font-medium tracking-tight text-stone-950 sm:text-4xl lg:text-5xl">
            {templatesPage.heading}
          </h1>
          <div class="mt-3 h-1 w-14 rounded-full" style={`background-color: ${accent}`} />
          <p class="mt-6 max-w-2xl text-base leading-relaxed text-stone-700">
            {templatesPage.intro}
          </p>

          <div class="mt-6 max-w-2xl rounded-2xl border border-stone-300 bg-white p-5">
            <p class="text-xs uppercase tracking-[0.16em] text-stone-500">Not for sale yet</p>
            <p class="mt-2 text-sm leading-relaxed text-stone-700">{templatesPage.notForSale}</p>
            {
              schedulingUrl && (
                <p class="mt-4 max-w-xl text-sm leading-relaxed text-stone-700">
                  Want me to wire this into your CRM in 10 days?
                </p>
              )
            }
            <div class="mt-4 flex flex-col items-start gap-3 sm:flex-row sm:flex-wrap sm:items-center">
              {
                schedulingUrl && (
                  <a
                    href={schedulingUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center rounded-full px-4 py-2 text-sm font-medium text-white hover:opacity-90 focus-visible:outline-2 focus-visible:outline-offset-2"
                    style={`background-color: ${accent}; outline-color: ${accent}`}
                  >
                    Book a 15-min ops audit
                  </a>
                )
              }
              {
                siteConfig.social.email && (
                  <a
                    href={waitlistHref(siteConfig.social.email)}
                    class:list={[
                      "inline-flex items-center rounded-full px-4 py-2 text-sm font-medium focus-visible:outline-2 focus-visible:outline-offset-2",
                      schedulingUrl
                        ? "border border-stone-300 bg-white text-stone-950 hover:border-stone-500"
                        : "text-white hover:opacity-90",
                    ]}
                    style={schedulingUrl ? undefined : `background-color: ${accent}; outline-color: ${accent}`}
                  >
                    Join the waitlist by email
                  </a>
                )
              }
            </div>
          </div>
        </div>
      </section>

      <section class="border-b border-stone-200" aria-labelledby="tiers-heading">
        <div class="mx-auto max-w-6xl px-6 py-12 sm:px-10">
          <h2 id="tiers-heading" class="text-xl font-medium tracking-tight text-stone-950">
            Three ways a pack may be offered
          </h2>
          <p class="mt-3 max-w-2xl text-sm leading-relaxed text-stone-600">
            Pick the outcome you want: do it yourself, set it up together, or have it installed. Which tiers each pack will have, and at what price, is not decided yet. Manager Digest is free; every paid tier shows "{PRICE_PENDING}."
          </p>
          <div class="mt-6">
            <TierTable />
          </div>
          <p class="mt-4 max-w-2xl text-xs leading-relaxed text-stone-500">{setupAgentNote}</p>
        </div>
      </section>

      <section class="border-b border-stone-200" aria-labelledby="catalog-heading">
        <div class="mx-auto max-w-6xl px-6 py-12 sm:px-10">
          <h2 id="catalog-heading" class="text-xl font-medium tracking-tight text-stone-950">
            The packs
          </h2>

          <div
            id="pack-filters"
            class="mt-5 flex flex-wrap gap-2"
            role="group"
            aria-label="Filter packs by category"
            hidden
          >
            <button
              type="button"
              data-filter="all"
              aria-pressed="true"
              class="filter-chip rounded-full border px-3 py-1.5 text-sm"
            >
              All <span class="text-stone-500">({templatePacks.length})</span>
            </button>
            {
              visibleCategories.map((c) => (
                <button
                  type="button"
                  data-filter={c.id}
                  aria-pressed="false"
                  class="filter-chip rounded-full border px-3 py-1.5 text-sm"
                >
                  {c.label} <span class="text-stone-500">({chipCounts[c.id]})</span>
                </button>
              ))
            }
          </div>
          <p id="pack-filter-status" class="sr-only" aria-live="polite"></p>

          <ul id="pack-grid" class="mt-6 grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
            {
              templatePacks.map((pack) => (
                <li data-categories={packFilters(pack).join(" ")} class="pack-card">
                  <article class="flex h-full flex-col rounded-2xl border border-stone-200 bg-white p-5 sm:p-6">
                    <div class="flex flex-wrap items-center gap-2">
                      <span class="text-xs uppercase tracking-[0.16em] text-stone-500">
                        {categoryLabel(pack.category)}
                      </span>
                      <span class="text-xs text-stone-400" aria-hidden="true">·</span>
                      <span class="text-xs text-stone-500">{pack.version}</span>
                      {(pack.free || pack.badge) && (
                        <span class="ml-auto flex items-center gap-2">
                          {pack.badge && (
                            <span
                              class="rounded-full px-2.5 py-0.5 text-xs font-semibold uppercase tracking-[0.12em] text-white"
                              style={`background-color: ${accent}`}
                            >
                              {pack.badge}
                            </span>
                          )}
                          {pack.free && (
                            <span
                              class="rounded-full px-2.5 py-0.5 text-xs font-semibold uppercase tracking-[0.12em] text-white"
                              style={`background-color: ${accent}`}
                            >
                              Free
                            </span>
                          )}
                        </span>
                      )}
                    </div>
                    <h3 class="mt-3 text-lg font-medium tracking-tight text-stone-950">
                      <a
                        href={`/templates/${pack.slug}`}
                        class="hover:text-[var(--accent)] hover:underline underline-offset-4"
                      >
                        {pack.name}
                      </a>
                    </h3>
                    <p class="mt-3 text-sm leading-relaxed text-stone-600">{pack.summary}</p>
                    <p class="mt-3 text-sm leading-relaxed text-stone-700">
                      <span class="font-medium">Safety first:</span> {pack.safety}
                    </p>
                    <p class="mt-3 text-xs text-stone-500">
                      {pack.workflows.length} {pack.workflows.length === 1 ? "workflow" : "workflows"} · {pack.totalNodes} executable nodes · Setup Agent compatible
                    </p>
                    <div class="mt-auto flex items-center justify-between gap-4 pt-5">
                      <p
                        class="text-sm font-medium"
                        style={pack.free ? `color: ${accent}` : undefined}
                      >
                        {pack.free ? "Free" : PRICE_PENDING}
                      </p>
                      <a
                        href={`/templates/${pack.slug}`}
                        class="text-sm text-stone-950 underline decoration-stone-300 underline-offset-4 hover:decoration-[var(--accent)]"
                        aria-label={`View ${pack.name}`}
                      >
                        View pack →
                      </a>
                    </div>
                  </article>
                </li>
              ))
            }
          </ul>
          <p id="pack-empty" class="mt-6 text-sm text-stone-600" hidden>
            No packs in this category yet. <button type="button" data-filter="all" class="filter-reset underline underline-offset-4">Show all packs</button>
          </p>
        </div>
      </section>

      <section class="border-b border-stone-200" aria-labelledby="guardrails-heading">
        <div class="mx-auto grid max-w-6xl grid-cols-1 gap-8 px-6 py-12 sm:px-10 lg:grid-cols-12">
          <div class="lg:col-span-4">
            <h2 id="guardrails-heading" class="text-xl font-medium tracking-tight text-stone-950">
              Production Guardrails in every pack
            </h2>
            <div class="mt-3 h-1 w-10 rounded-full" style={`background-color: ${accent}`} />
            <p class="mt-4 text-sm leading-relaxed text-stone-600">
              {templatesPage.sampleDataNote} Consent, opt-out, quiet hours, A2P 10DLC, sales tax, and privacy stay your responsibility; nothing here is legal, tax, or accounting advice.
            </p>
          </div>
          <ul class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:col-span-8">
            {
              shortGuardrails.map((g) => (
                <li class="rounded-2xl border border-stone-200 bg-white p-4">
                  <p class="text-sm font-medium text-stone-950">{g.title}</p>
                  <p class="mt-1 text-sm leading-relaxed text-stone-600">{g.body}</p>
                </li>
              ))
            }
          </ul>
        </div>
      </section>

      <section aria-labelledby="calc-heading">
        <div class="mx-auto max-w-6xl px-6 py-12 sm:px-10">
          <div class="flex flex-col gap-4 rounded-2xl border border-stone-200 bg-white p-6 sm:flex-row sm:items-center sm:justify-between">
            <div>
              <h2 id="calc-heading" class="text-lg font-medium tracking-tight text-stone-950">
                Estimate automation value first
              </h2>
              <p class="mt-2 max-w-xl text-sm leading-relaxed text-stone-600">
                Use your own numbers to estimate time saved, and check an AI agent's guardrails before go-live. The calculators make no claims about these packs.
              </p>
            </div>
            <a
              href="/calculators"
              class="shrink-0 text-sm text-stone-950 underline decoration-stone-300 underline-offset-4 hover:decoration-[var(--accent)]"
            >
              Open the calculators →
            </a>
          </div>
        </div>
      </section>
    </main>
    <Footer />

    <style>
      .filter-chip {
        border-color: #d6d3d1;
        background-color: #fff;
        color: #44403c;
      }
      .filter-chip:hover {
        border-color: var(--accent);
      }
      .filter-chip:focus-visible,
      .filter-reset:focus-visible {
        outline: 2px solid var(--accent);
        outline-offset: 2px;
      }
      .filter-chip[aria-pressed="true"] {
        border-color: var(--accent);
        background-color: var(--accent);
        color: #fff;
      }
      .filter-chip[aria-pressed="true"] span {
        color: #e7e5e4;
      }
    </style>

    <script>
      const bar = document.getElementById("pack-filters");
      const cards = Array.from(document.querySelectorAll<HTMLElement>(".pack-card"));
      const empty = document.getElementById("pack-empty");
      const status = document.getElementById("pack-filter-status");

      if (bar) {
        bar.hidden = false;
        const chips = Array.from(bar.querySelectorAll<HTMLButtonElement>("button[data-filter]"));

        const apply = (filter: string) => {
          let shown = 0;
          for (const card of cards) {
            const tags = (card.dataset.categories ?? "").split(" ");
            const match = filter === "all" || tags.includes(filter);
            card.hidden = !match;
            if (match) shown++;
          }
          for (const chip of chips) {
            chip.setAttribute("aria-pressed", String(chip.dataset.filter === filter));
          }
          if (empty) empty.hidden = shown > 0;
          if (status) status.textContent = `${shown} ${shown === 1 ? "pack" : "packs"} shown`;
        };

        for (const btn of document.querySelectorAll<HTMLButtonElement>("button[data-filter]")) {
          btn.addEventListener("click", () => apply(btn.dataset.filter ?? "all"));
        }
      }
    </script>
  </body>
</html>
